# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
SUPABASE_URL=https://qgvxjnlwtvgsdjixglvv.supabase.co
# Anon public key (safe for client-side)
SUPABASE_KEY=your_supabase_anon_key
# Service Role key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional direct Postgres connection string (for migrations/pooler)
SUPABASE_DB_URL=postgresql://postgres.qgvxjnlwtvgsdjixglvv:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ==============================================================================
# SATELLITE & MARITIME RADAR FEEDS
# ==============================================================================
COPERNICUS_CLIENT_ID=your_copernicus_id
COPERNICUS_CLIENT_SECRET=your_copernicus_secret
COPERNICUS_MOCK_MODE=true

GFW_API_KEY=your_gfw_key
AIS_MOCK_MODE=true

MODEL_DEMO_MODE=true
